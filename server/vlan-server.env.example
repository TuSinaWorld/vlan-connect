# Copy to /usr/local/bin/vlan-server.env and edit.
#
# The server listens on the same TCP and UDP port.
VLAN_SERVER_PORT=11510

# Application log file and max single log size in MB.
VLAN_SERVER_LOG=/var/log/vlan-server/server.log
VLAN_SERVER_LOG_MAX_MB=10

# Server authentication is enabled by default by vlan-server.service.
# The first line of this file is used as the server authentication password.
VLAN_SERVER_AUTH_FILE=/usr/local/bin/auth.password

# Optional extra server arguments. vlan-server.service already enables -v.
VLAN_SERVER_EXTRA_ARGS=
