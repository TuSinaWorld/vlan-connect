#include <windows.h>
#include "../../common/version.h"

IDI_ICON1 ICON "vlan.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VLAN_RELEASE_VERSION_COMMA
 PRODUCTVERSION VLAN_RELEASE_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "VLan GUI Client\0"
            VALUE "FileVersion", VLAN_RELEASE_VERSION_WINDOWS "\0"
            VALUE "InternalName", "VLanClient\0"
            VALUE "OriginalFilename", "VLanClient.exe\0"
            VALUE "ProductName", "VLan\0"
            VALUE "ProductVersion", VLAN_RELEASE_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
